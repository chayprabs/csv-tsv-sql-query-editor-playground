# Upstash Redis (optional). When both are set, Redis-backed rate limits are used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upload limits (bytes). Per-file and combined total default 50MB unless overridden.
MAX_UPLOAD_BYTES=52428800
NEXT_PUBLIC_MAX_UPLOAD_BYTES=52428800
MAX_TOTAL_UPLOAD_BYTES=52428800
NEXT_PUBLIC_MAX_TOTAL_UPLOAD_BYTES=52428800
NEXT_PUBLIC_MAX_FILE_COUNT=20
NEXT_PUBLIC_MAX_RESULT_ROWS=50000
NEXT_PUBLIC_QUERY_TIMEOUT_MS=30000
NEXT_PUBLIC_MAX_QUERY_LENGTH=10000
FLATFILE_SQL_STUDIO_MAX_UPLOAD_BYTES=
FLATFILE_SQL_STUDIO_MAX_TOTAL_UPLOAD_BYTES=

MAX_FILE_COUNT=20
FLATFILE_SQL_STUDIO_MAX_FILES_PER_REQUEST=

MAX_RESULT_ROWS=50000
FLATFILE_SQL_STUDIO_MAX_RESULT_ROWS=

QUERY_TIMEOUT_MS=30000
FLATFILE_SQL_STUDIO_QUERY_TIMEOUT_MS=

MAX_HEAP_MB=512

RATE_LIMIT_REQUESTS_PER_MINUTE=10
RATE_LIMIT_BANDWIDTH_MB_PER_HOUR=200
RATE_LIMIT_MAX_CONCURRENT_PER_IP=3
RATE_LIMIT_MAX_CONCURRENT_GLOBAL=20

FLATFILE_SQL_STUDIO_AUTO_INDEX_MAX_COLUMNS=1
FLATFILE_SQL_STUDIO_AUTO_INDEX_ROW_THRESHOLD=75000
