{
  "name": "flatfile-sql-studio",
  "version": "0.1.0",
  "description": "Browser-based SQLite query workspace for uploaded delimited files.",
  "private": true,
  "type": "module",
  "scripts": {
    "benchmark:api": "tsx benchmarks/benchmark-api.ts",
    "benchmark:baseline": "tsx benchmarks/run-baseline.ts",
    "benchmark:memory": "tsx benchmarks/benchmark-memory.ts",
    "benchmark:parsing": "tsx benchmarks/benchmark-parsing.ts",
    "benchmark:query": "tsx benchmarks/benchmark-query.ts",
    "dev": "next dev",
    "build": "next build",
    "fixtures:generate": "ts-node scripts/generate-fixtures.ts",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:performance": "ts-node tests/performance/benchmarks.ts"
  },
  "dependencies": {
    "@types/busboy": "^1.5.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "better-sqlite3": "^12.8.0",
    "busboy": "^1.6.0",
    "next": "^14.2.33",
    "papaparse": "^5.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/autocannon": "^7.12.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitest/coverage-v8": "^4.1.2",
    "autocannon": "^8.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.33",
    "jsdom": "^26.1.0",
    "playwright": "^1.59.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^4.1.2"
  },
  "ts-node": {
    "esm": true,
    "transpileOnly": true
  }
}
